{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/static-os/schema/world-recursion-receipt-v0.json",
  "title": "WORLD recursion receipt v0",
  "type": "object",
  "required": [
    "schema",
    "packet_id",
    "candidate_source_sha256",
    "lineage_class",
    "novelty_status",
    "observation_status",
    "relation_to_upstream",
    "independence_status",
    "counts_as_second_witness",
    "upstream_ancestry_preserved",
    "establishes",
    "does_not_establish",
    "next_door"
  ],
  "properties": {
    "schema": {"const": "static.world-recursion-receipt/v0"},
    "packet_id": {"const": "world-001"},
    "candidate_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lineage_class": {"const": "generated_downstream"},
    "novelty_status": {"const": "new_artifact"},
    "observation_status": {"const": "fresh_capture"},
    "relation_to_upstream": {
      "enum": [
        "aligns_primary",
        "aligns_candidate",
        "mixed",
        "inconclusive"
      ]
    },
    "independence_status": {"const": "not_independent_by_generation"},
    "counts_as_second_witness": {"const": false},
    "upstream_ancestry_preserved": {"const": true},
    "establishes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "next_door": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
