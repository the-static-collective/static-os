{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/nav-residual-witness-admission-v0.json",
  "title":"NAV residual witness admission v0",
  "type":"object",
  "required":[
    "schema","status","heading","original_field_sha256","first_update_sha256",
    "first_contact_sha256","candidate_sha256","transition_sha256",
    "reorientation_sha256","admitted_by","claim_limit"
  ],
  "properties":{
    "schema":{"const":"static.nav-residual-witness-admission/v0"},
    "status":{"const":"admitted"},
    "heading":{"type":"string","minLength":1},
    "original_field_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "first_update_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "first_contact_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "candidate_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "transition_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "reorientation_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "admitted_by":{"type":"string","minLength":1},
    "claim_limit":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}