{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/static-os/schema/witness-reentry-v0.json",
  "title": "WITNESS re-entry v0",
  "type": "object",
  "required": [
    "schema",
    "packet_id",
    "source_bundle",
    "records",
    "establishes",
    "does_not_establish",
    "corrections",
    "next_door"
  ],
  "properties": {
    "schema": {"const": "static.witness-reentry/v0"},
    "packet_id": {"const": "witness-001"},
    "source_bundle": {
      "type": "object",
      "required": [
        "ground_receipt",
        "evidence_artifact",
        "ancestry"
      ],
      "properties": {
        "ground_receipt": {
          "type": "object",
          "required": ["schema", "packet_id", "status", "sha256"],
          "properties": {
            "schema": {"const": "static.ground-receipt/v0"},
            "packet_id": {"const": "make-ground-001"},
            "status": {"const": "observed"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "evidence_artifact": {
          "type": "object",
          "required": ["schema", "artifact_id", "sha256"],
          "properties": {
            "schema": {"const": "static.evidence-artifact/v0"},
            "artifact_id": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "ancestry": {
          "type": "object",
          "required": [
            "ground_plan_sha256",
            "world_primary_source_sha256",
            "world_candidate_source_sha256"
          ],
          "properties": {
            "ground_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "world_primary_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "world_candidate_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["kind", "value", "source_field", "claim_class"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "value": {"type": "string"},
          "source_field": {"type": "string", "minLength": 1},
          "claim_class": {
            "enum": [
              "source_record",
              "source_artifact",
              "derivative_interpretation",
              "intervention_record",
              "source_limit",
              "lineage_record"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "establishes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "corrections": {"type": "array"},
    "next_door": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
