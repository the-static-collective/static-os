{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/world-composed-contact-candidate-v0.json",
  "title":"WORLD composed-contact candidate v0",
  "type":"object",
  "required":[
    "schema","candidate_id","source_sha256","source_schema",
    "novelty_status","observation_status","orientation_ancestry",
    "selection_independence","measurement_independence",
    "confirmation_status","claim_limit"
  ],
  "properties":{
    "schema":{"const":"static.world-composed-contact-candidate/v0"},
    "candidate_id":{"type":"string","minLength":1},
    "source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_schema":{"const":"static.nav-receipt/v0"},
    "novelty_status":{"const":"new_source_artifact"},
    "observation_status":{"const":"fresh_world_contact"},
    "orientation_ancestry":{
      "type":"object",
      "required":[
        "cycle_sha256","origin_sha256","source_generation_sha256",
        "admission_sha256","weave_capsule_sha256","parent_set_sha256",
        "weave_ledger_sha256","root_cycle_digest","relation_kinds"
      ],
      "properties":{
        "cycle_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "origin_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "source_generation_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "admission_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "weave_capsule_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "parent_set_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "weave_ledger_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "root_cycle_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "relation_kinds":{
          "type":"array","minItems":2,"uniqueItems":true,
          "items":{"enum":["branch_continuation","open_branch"]}
        }
      },
      "additionalProperties":false
    },
    "selection_independence":{"const":"not_independent_of_orientation"},
    "measurement_independence":{"const":"unknown"},
    "confirmation_status":{"const":"independent_confirmation_not_established"},
    "claim_limit":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
