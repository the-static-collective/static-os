{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/nav-residual-witness-reorientation-v0.json",
  "title":"NAV residual witness reorientation v0",
  "type":"object",
  "required":[
    "schema","packet_id","status","original_field_sha256","first_update_sha256",
    "first_contact_sha256","transition_sha256","candidate_sha256",
    "prior_supported_relation","target_challenged_relation","proposed_heading",
    "bounded_move","preserved","claim_limit"
  ],
  "properties":{
    "schema":{"const":"static.nav-residual-witness-reorientation/v0"},
    "packet_id":{"const":"nav-001"},
    "status":{"const":"proposed"},
    "original_field_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "first_update_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "first_contact_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "transition_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "candidate_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "prior_supported_relation":{"enum":["corroborates","contradicts","corrects"]},
    "target_challenged_relation":{"enum":["corroborates","contradicts","corrects"]},
    "proposed_heading":{"type":"string","minLength":1},
    "bounded_move":{"type":"string","minLength":1},
    "preserved":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "claim_limit":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
