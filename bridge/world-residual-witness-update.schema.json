{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/world-residual-witness-update-v0.json",
  "title":"WORLD residual witness update v0",
  "type":"object",
  "required":[
    "schema","packet_id","original_field_sha256","first_update_sha256",
    "contact_history_sha256s","prior_supported_relation","target_challenged_relation",
    "second_observed_relation","residual_tension_status","historical_supported_relations",
    "witness_history","witness_count_before","witness_count_after",
    "all_witnesses_retained","first_contact_promoted_to_verdict",
    "majority_rule_used","verdict_status","establishes","does_not_establish","next_door"
  ],
  "properties":{
    "schema":{"const":"static.world-residual-witness-update/v0"},
    "packet_id":{"const":"world-001"},
    "original_field_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "first_update_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "contact_history_sha256s":{
      "type":"array","minItems":2,"maxItems":2,"uniqueItems":true,
      "items":{"type":"string","pattern":"^[0-9a-f]{64}$"}
    },
    "prior_supported_relation":{"enum":["corroborates","contradicts","corrects"]},
    "target_challenged_relation":{"enum":["corroborates","contradicts","corrects"]},
    "second_observed_relation":{"enum":["corroborates","contradicts","corrects"]},
    "residual_tension_status":{"enum":["challenged_path_survives_second_contact","challenged_path_challenged_again"]},
    "historical_supported_relations":{
      "type":"array","minItems":1,"maxItems":2,"uniqueItems":true,
      "items":{"enum":["corroborates","contradicts","corrects"]}
    },
    "witness_history":{
      "type":"array","minItems":2,
      "items":{
        "type":"object",
        "required":["source_sha256","original_relation","first_contact_state","second_contact_state"],
        "properties":{
          "source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "original_relation":{"enum":["corroborates","contradicts","corrects","unrelated"]},
          "first_contact_state":{"enum":["aligned_with_contact","challenged_by_contact","outside_discriminator_scope"]},
          "second_contact_state":{"enum":["aligned_with_contact","challenged_by_contact","outside_discriminator_scope"]}
        },
        "additionalProperties":false
      }
    },
    "witness_count_before":{"type":"integer","minimum":2},
    "witness_count_after":{"type":"integer","minimum":2},
    "all_witnesses_retained":{"const":true},
    "first_contact_promoted_to_verdict":{"const":false},
    "majority_rule_used":{"const":false},
    "verdict_status":{"const":"withheld"},
    "establishes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "does_not_establish":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "next_door":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
