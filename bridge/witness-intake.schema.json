{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/static-os/schema/witness-intake-v0.json",
  "title": "WITNESS intake v0",
  "type": "object",
  "required": [
    "schema",
    "packet_id",
    "source",
    "records",
    "establishes",
    "does_not_establish",
    "corrections"
  ],
  "properties": {
    "schema": {"const": "static.witness-intake/v0"},
    "packet_id": {"const": "witness-001"},
    "source": {
      "type": "object",
      "required": [
        "schema",
        "packet_id",
        "status",
        "sha256"
      ],
      "properties": {
        "schema": {"type": "string", "minLength": 1},
        "packet_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "value", "source_field", "claim_class"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "value": {"type": "string"},
          "source_field": {"type": "string", "minLength": 1},
          "claim_class": {
            "enum": [
              "source_record",
              "derivative_interpretation",
              "orientation_proposal",
              "source_limit"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "establishes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_index", "replacement", "reason"],
        "properties": {
          "record_index": {"type": "integer", "minimum": 0},
          "replacement": {"type": "string"},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
