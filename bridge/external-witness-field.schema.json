{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/external-witness-field-v0.json",
  "title":"External witness field v0",
  "type":"object",
  "required":["schema","field_id","composed_source_sha256","witnesses","pair_audits","claim_limit"],
  "properties":{
    "schema":{"const":"static.external-witness-field/v0"},
    "field_id":{"type":"string","minLength":1},
    "composed_source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "witnesses":{
      "type":"array","minItems":2,
      "items":{
        "type":"object",
        "required":["source_sha256","receipt_sha256","claim_relation"],
        "properties":{
          "source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "claim_relation":{"enum":["corroborates","contradicts","corrects","unrelated"]}
        },
        "additionalProperties":false
      }
    },
    "pair_audits":{
      "type":"array","minItems":1,
      "items":{
        "type":"object",
        "required":["source_a_sha256","source_b_sha256","audit_sha256"],
        "properties":{
          "source_a_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "source_b_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "audit_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
        },
        "additionalProperties":false
      }
    },
    "claim_limit":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
