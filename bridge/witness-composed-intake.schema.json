{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/witness-composed-intake-v0.json",
  "title":"WITNESS composed-origin NAV intake v0",
  "type":"object",
  "required":[
    "schema","packet_id","source","origin_provenance","records",
    "establishes","does_not_establish","corrections","next_door"
  ],
  "properties":{
    "schema":{"const":"static.witness-composed-intake/v0"},
    "packet_id":{"const":"witness-001"},
    "source":{
      "type":"object",
      "required":["schema","packet_id","status","sha256","intake_sha256"],
      "properties":{
        "schema":{"const":"static.nav-receipt/v0"},
        "packet_id":{"const":"nav-001"},
        "status":{"const":"contacted"},
        "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "intake_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      },
      "additionalProperties":false
    },
    "origin_provenance":{
      "type":"object",
      "required":[
        "cycle_sha256","origin_sha256","source_generation_sha256",
        "admission_sha256","weave_capsule_sha256","parent_set_sha256",
        "weave_ledger_sha256","root_cycle_digest","relation_kinds"
      ],
      "properties":{
        "cycle_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "origin_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "source_generation_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "admission_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "weave_capsule_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "parent_set_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "weave_ledger_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "root_cycle_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "relation_kinds":{
          "type":"array",
          "minItems":2,
          "uniqueItems":true,
          "items":{"enum":["branch_continuation","open_branch"]}
        }
      },
      "additionalProperties":false
    },
    "records":{
      "type":"array",
      "minItems":4,
      "maxItems":4,
      "items":{
        "type":"object",
        "required":["kind","value","source_field","claim_class"],
        "properties":{
          "kind":{"type":"string","minLength":1},
          "value":{"type":"string"},
          "source_field":{"type":"string","minLength":1},
          "claim_class":{
            "enum":[
              "source_record",
              "derivative_interpretation",
              "orientation_proposal",
              "source_limit"
            ]
          }
        },
        "additionalProperties":false
      }
    },
    "establishes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "does_not_establish":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "corrections":{"type":"array"},
    "next_door":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
