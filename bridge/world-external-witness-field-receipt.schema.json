{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/world-external-witness-field-receipt-v0.json",
  "title":"WORLD external witness field receipt v0",
  "type":"object",
  "required":[
    "schema","packet_id","field_sha256","composed_source_sha256","witness_count",
    "plurality_status","field_state","relation_counts","pair_audit_summary",
    "majority_rule_used","verdict_status","typed_composed_origin_preserved",
    "establishes","does_not_establish","next_door"
  ],
  "properties":{
    "schema":{"const":"static.world-external-witness-field-receipt/v0"},
    "packet_id":{"const":"world-001"},
    "field_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "composed_source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "witness_count":{"type":"integer","minimum":2},
    "plurality_status":{"enum":["independent_plurality_candidate","inter_witness_independence_unknown","shared_external_lineage"]},
    "field_state":{"enum":["convergence_without_verdict","disagreement_preserved","mixed_relevance","plurality_not_established"]},
    "relation_counts":{
      "type":"object",
      "required":["corroborates","contradicts","corrects","unrelated"],
      "properties":{
        "corroborates":{"type":"integer","minimum":0},
        "contradicts":{"type":"integer","minimum":0},
        "corrects":{"type":"integer","minimum":0},
        "unrelated":{"type":"integer","minimum":0}
      },
      "additionalProperties":false
    },
    "pair_audit_summary":{
      "type":"object",
      "required":["passed","unknown","failed"],
      "properties":{
        "passed":{"type":"integer","minimum":0},
        "unknown":{"type":"integer","minimum":0},
        "failed":{"type":"integer","minimum":0}
      },
      "additionalProperties":false
    },
    "majority_rule_used":{"const":false},
    "verdict_status":{"const":"withheld"},
    "typed_composed_origin_preserved":{"const":true},
    "establishes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "does_not_establish":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "next_door":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
