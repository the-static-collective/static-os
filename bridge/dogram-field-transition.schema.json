{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/dogram-field-transition-v0.json",
  "title":"Dogram witness-field transition v0",
  "type":"object",
  "required":[
    "schema","transition_id","field_sha256","field_receipt_sha256",
    "live_relations","candidate_sha256","to_heading","bounded_move",
    "cost_vector","preserved","selection_basis","status","claim_limit"
  ],
  "properties":{
    "schema":{"const":"static.dogram-field-transition/v0"},
    "transition_id":{"type":"string","minLength":1},
    "field_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "field_receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "live_relations":{
      "type":"array","minItems":2,"uniqueItems":true,
      "items":{"enum":["corroborates","contradicts","corrects"]}
    },
    "candidate_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "to_heading":{"type":"string","minLength":1},
    "bounded_move":{"type":"string","minLength":1},
    "cost_vector":{
      "type":"object",
      "required":["irreversible_steps","changed_variables","world_contacts","external_dependencies"],
      "properties":{
        "irreversible_steps":{"const":0},
        "changed_variables":{"type":"integer","minimum":1},
        "world_contacts":{"const":1},
        "external_dependencies":{"type":"integer","minimum":0}
      },"additionalProperties":false
    },
    "preserved":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "selection_basis":{"const":"minimum_declared_structural_cost"},
    "status":{"const":"proposed"},
    "claim_limit":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
