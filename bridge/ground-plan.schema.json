{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/static-os/schema/ground-plan-v0.json",
  "title": "MAKE GROUND plan v0",
  "type": "object",
  "required": [
    "schema",
    "packet_id",
    "status",
    "world_source",
    "field_id",
    "question",
    "intervention",
    "preserve",
    "observation",
    "fertility_target",
    "success_condition",
    "rollback_condition",
    "claim_limit",
    "truth_claimed"
  ],
  "properties": {
    "schema": {"const": "static.ground-plan/v0"},
    "packet_id": {"const": "make-ground-001"},
    "status": {"const": "proposed"},
    "world_source": {
      "type": "object",
      "required": [
        "primary_source_sha256",
        "candidate_source_sha256",
        "lineage_class",
        "claim_relation"
      ],
      "properties": {
        "primary_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lineage_class": {"const": "independent_candidate"},
        "claim_relation": {"enum": ["contradicts", "corrects"]}
      },
      "additionalProperties": false
    },
    "field_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "intervention": {
      "type": "object",
      "required": ["lever_id", "change", "rollback"],
      "properties": {
        "lever_id": {"type": "string", "minLength": 1},
        "change": {"type": "string", "minLength": 1},
        "rollback": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "preserve": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "observation": {
      "type": "object",
      "required": ["channel_id", "description", "capture"],
      "properties": {
        "channel_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "capture": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "fertility_target": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "success_condition": {"type": "string", "minLength": 1},
    "rollback_condition": {"type": "string", "minLength": 1},
    "claim_limit": {"type": "string", "minLength": 1},
    "truth_claimed": {"const": false}
  },
  "additionalProperties": false
}
