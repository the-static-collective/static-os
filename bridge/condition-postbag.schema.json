{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/condition-postbag-v0.json",
  "title":"Condition postbag v0",
  "type":"object",
  "required":[
    "schema","original_field_sha256","residual_update_sha256",
    "returns","return_order_ranked","all_returns_held","claim_limit"
  ],
  "properties":{
    "schema":{"const":"static.condition-postbag/v0"},
    "original_field_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "residual_update_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "returns":{
      "type":"array","minItems":3,"maxItems":3,
      "items":{
        "type":"object",
        "required":["branch_sha256","result_sha256"],
        "properties":{
          "branch_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "result_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
        },
        "additionalProperties":false
      }
    },
    "return_order_ranked":{"const":false},
    "all_returns_held":{"const":true},
    "claim_limit":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}