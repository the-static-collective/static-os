{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/world-composed-contact-receipt-v0.json",
  "title":"WORLD composed-contact receipt v0",
  "type":"object",
  "required":[
    "schema","packet_id","candidate_source_sha256","lineage_class",
    "novelty_status","observation_status","selection_independence",
    "measurement_independence","confirmation_status","counts_as_independent_confirmation",
    "typed_origin_preserved","establishes","does_not_establish","next_door"
  ],
  "properties":{
    "schema":{"const":"static.world-composed-contact-receipt/v0"},
    "packet_id":{"const":"world-001"},
    "candidate_source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "lineage_class":{"const":"oriented_downstream"},
    "novelty_status":{"const":"new_source_artifact"},
    "observation_status":{"const":"fresh_world_contact"},
    "selection_independence":{"const":"not_independent_of_orientation"},
    "measurement_independence":{"enum":["unknown","independent_candidate","not_independent"]},
    "confirmation_status":{"enum":[
      "independent_confirmation_not_established",
      "independent_confirmation_candidate",
      "not_independent_confirmation"
    ]},
    "counts_as_independent_confirmation":{"type":"boolean"},
    "typed_origin_preserved":{"const":true},
    "establishes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "does_not_establish":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "next_door":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
