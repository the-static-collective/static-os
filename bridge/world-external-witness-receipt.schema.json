{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/world-external-witness-receipt-v0.json",
  "title":"WORLD external witness receipt v0",
  "type":"object",
  "required":[
    "schema","packet_id","composed_source_sha256","external_source_sha256",
    "selection_audit_sha256","measurement_audit_sha256","comparison_sha256",
    "lineage_class","selection_independence","measurement_independence",
    "independent_witness_status","counts_as_independent_witness","claim_relation",
    "relation_role","typed_composed_origin_preserved","selection_summary",
    "measurement_summary","establishes","does_not_establish","next_door"
  ],
  "properties":{
    "schema":{"const":"static.world-external-witness-receipt/v0"},
    "packet_id":{"const":"world-001"},
    "composed_source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "external_source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "selection_audit_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "measurement_audit_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "comparison_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "lineage_class":{"enum":["independent_external_candidate","external_independence_unknown","external_not_independent"]},
    "selection_independence":{"enum":["independent_candidate","unknown","not_independent"]},
    "measurement_independence":{"enum":["independent_candidate","unknown","not_independent"]},
    "independent_witness_status":{"enum":["independent_witness_candidate","independence_not_established","not_independent_witness"]},
    "counts_as_independent_witness":{"type":"boolean"},
    "claim_relation":{"enum":["corroborates","contradicts","corrects","unrelated"]},
    "relation_role":{"enum":[
      "independent_corroboration_candidate","independent_contradiction_candidate",
      "independent_correction_candidate","independent_unrelated_source",
      "relation_without_independent_witness_status"
    ]},
    "typed_composed_origin_preserved":{"const":true},
    "selection_summary":{
      "type":"object","required":["passed","unknown","failed"],
      "properties":{
        "passed":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "unknown":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "failed":{"type":"array","items":{"type":"string"},"uniqueItems":true}
      },"additionalProperties":false
    },
    "measurement_summary":{
      "type":"object","required":["passed","unknown","failed"],
      "properties":{
        "passed":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "unknown":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "failed":{"type":"array","items":{"type":"string"},"uniqueItems":true}
      },"additionalProperties":false
    },
    "establishes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "does_not_establish":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "next_door":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
