{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/condition-world-branch-v0.json",
  "title":"Condition world branch v0",
  "type":"object",
  "required":[
    "schema","branch_id","original_field_sha256","residual_update_sha256",
    "owner","admission_status","changed_condition","preserved",
    "mineral_want","claim_limit"
  ],
  "properties":{
    "schema":{"const":"static.condition-world-branch/v0"},
    "branch_id":{"type":"string","minLength":1},
    "original_field_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "residual_update_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "owner":{"type":"string","minLength":1},
    "admission_status":{"const":"admitted"},
    "changed_condition":{
      "type":"object",
      "required":["name","before","after"],
      "properties":{
        "name":{"type":"string","minLength":1},
        "before":{"type":"string"},
        "after":{"type":"string"}
      },
      "additionalProperties":false
    },
    "preserved":{
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"type":"string","minLength":1}
    },
    "mineral_want":{
      "anyOf":[
        {"type":"null"},
        {
          "type":"object",
          "required":["request_sha256","mineral_kind","status","authorization"],
          "properties":{
            "request_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
            "mineral_kind":{"type":"string","minLength":1},
            "status":{"const":"requested"},
            "authorization":{"const":"none"}
          },
          "additionalProperties":false
        }
      ]
    },
    "claim_limit":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}