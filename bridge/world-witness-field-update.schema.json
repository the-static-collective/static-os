{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/world-witness-field-update-v0.json",
  "title":"WORLD witness field discrimination update v0",
  "type":"object",
  "required":[
    "schema","packet_id","original_field_sha256","original_field_receipt_sha256",
    "discrimination_contact_sha256","observed_relation","live_relations_before",
    "contact_supported_relations","contact_challenged_relations",
    "witness_states","witness_count_before","witness_count_after",
    "all_witnesses_retained","ambiguity_before","ambiguity_after",
    "majority_rule_used","verdict_status","establishes","does_not_establish","next_door"
  ],
  "properties":{
    "schema":{"const":"static.world-witness-field-update/v0"},
    "packet_id":{"const":"world-001"},
    "original_field_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "original_field_receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "discrimination_contact_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "observed_relation":{"enum":["corroborates","contradicts","corrects"]},
    "live_relations_before":{
      "type":"array","minItems":2,"uniqueItems":true,
      "items":{"enum":["corroborates","contradicts","corrects"]}
    },
    "contact_supported_relations":{
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"enum":["corroborates","contradicts","corrects"]}
    },
    "contact_challenged_relations":{
      "type":"array","uniqueItems":true,
      "items":{"enum":["corroborates","contradicts","corrects"]}
    },
    "witness_states":{
      "type":"array","minItems":2,
      "items":{
        "type":"object",
        "required":["source_sha256","original_relation","contact_state"],
        "properties":{
          "source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "original_relation":{"enum":["corroborates","contradicts","corrects","unrelated"]},
          "contact_state":{"enum":["aligned_with_contact","challenged_by_contact","outside_discriminator_scope"]}
        },
        "additionalProperties":false
      }
    },
    "witness_count_before":{"type":"integer","minimum":2},
    "witness_count_after":{"type":"integer","minimum":2},
    "all_witnesses_retained":{"const":true},
    "ambiguity_before":{"type":"integer","minimum":2},
    "ambiguity_after":{"type":"integer","minimum":1},
    "majority_rule_used":{"const":false},
    "verdict_status":{"const":"withheld"},
    "establishes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "does_not_establish":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "next_door":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
