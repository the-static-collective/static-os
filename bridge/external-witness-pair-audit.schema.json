{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/external-witness-pair-audit-v0.json",
  "title":"External witness pair independence audit v0",
  "type":"object",
  "required":["schema","audit_id","source_a_sha256","source_b_sha256","criteria","claim_limit"],
  "properties":{
    "schema":{"const":"static.external-witness-pair-audit/v0"},
    "audit_id":{"type":"string","minLength":1},
    "source_a_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_b_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "criteria":{
      "type":"object",
      "required":["shared_source_ancestry","operator_overlap","capture_coordination","selection_coordination"],
      "properties":{
        "shared_source_ancestry":{
          "type":"object",
          "required":["status","evidence_sha256"],
          "properties":{
            "status":{"enum":["no_shared_ancestor_evidence","shared_ancestor","unknown"]},
            "evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          },"additionalProperties":false
        },
        "operator_overlap":{
          "type":"object",
          "required":["status","evidence_sha256"],
          "properties":{
            "status":{"enum":["distinct_or_automatic","shared_operator","unknown"]},
            "evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          },"additionalProperties":false
        },
        "capture_coordination":{
          "type":"object",
          "required":["status","evidence_sha256"],
          "properties":{
            "status":{"enum":["not_coordinated","coordinated","unknown"]},
            "evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          },"additionalProperties":false
        },
        "selection_coordination":{
          "type":"object",
          "required":["status","evidence_sha256"],
          "properties":{
            "status":{"enum":["independently_selected","jointly_selected","unknown"]},
            "evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          },"additionalProperties":false
        }
      },
      "additionalProperties":false
    },
    "claim_limit":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
