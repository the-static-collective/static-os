{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/residual-witness-discriminator-candidate-v0.json",
  "title":"Residual witness discriminator candidate v0",
  "type":"object",
  "required":[
    "schema","candidate_id","original_field_sha256","first_update_sha256",
    "first_contact_sha256","prior_supported_relation","target_challenged_relation",
    "proposed_heading","bounded_move","paths","preserve","aperture",
    "stop_condition","cost_vector","claim_limit"
  ],
  "properties":{
    "schema":{"const":"static.residual-witness-discriminator-candidate/v0"},
    "candidate_id":{"type":"string","minLength":1},
    "original_field_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "first_update_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "first_contact_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "prior_supported_relation":{"enum":["corroborates","contradicts","corrects"]},
    "target_challenged_relation":{"enum":["corroborates","contradicts","corrects"]},
    "proposed_heading":{"type":"string","minLength":1},
    "bounded_move":{"type":"string","minLength":1},
    "paths":{
      "type":"array","minItems":2,"maxItems":2,
      "items":{
        "type":"object",
        "required":["relation","discriminating_observation"],
        "properties":{
          "relation":{"enum":["corroborates","contradicts","corrects"]},
          "discriminating_observation":{"type":"string","minLength":1}
        },
        "additionalProperties":false
      }
    },
    "preserve":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "aperture":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "stop_condition":{"type":"string","minLength":1},
    "cost_vector":{
      "type":"object",
      "required":["irreversible_steps","changed_variables","world_contacts","external_dependencies"],
      "properties":{
        "irreversible_steps":{"const":0},
        "changed_variables":{"type":"integer","minimum":1},
        "world_contacts":{"const":1},
        "external_dependencies":{"type":"integer","minimum":0}
      },
      "additionalProperties":false
    },
    "claim_limit":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
