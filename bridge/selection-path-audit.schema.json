{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/selection-path-audit-v0.json",
  "title":"Selection path audit v0",
  "type":"object",
  "required":["schema","audit_id","candidate_source_sha256","criteria","claim_limit"],
  "properties":{
    "schema":{"const":"static.selection-path-audit/v0"},
    "audit_id":{"type":"string","minLength":1},
    "candidate_source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "criteria":{
      "type":"object",
      "required":["question_origin","assignment_origin","hypothesis_exposure","sampling_frame"],
      "properties":{
        "question_origin":{
          "type":"object",
          "required":["status","evidence_sha256"],
          "properties":{
            "status":{"enum":["preexisting_or_external","derived_from_composed_history","unknown"]},
            "evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          },"additionalProperties":false
        },
        "assignment_origin":{
          "type":"object",
          "required":["status","evidence_sha256"],
          "properties":{
            "status":{"enum":["independently_assigned","assigned_by_composed_history","unknown"]},
            "evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          },"additionalProperties":false
        },
        "hypothesis_exposure":{
          "type":"object",
          "required":["status","evidence_sha256"],
          "properties":{
            "status":{"enum":["unexposed_to_composed_history","exposed_to_composed_history","unknown"]},
            "evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          },"additionalProperties":false
        },
        "sampling_frame":{
          "type":"object",
          "required":["status","evidence_sha256"],
          "properties":{
            "status":{"enum":["predeclared_or_external","selected_after_composed_result","unknown"]},
            "evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          },"additionalProperties":false
        }
      },
      "additionalProperties":false
    },
    "claim_limit":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
