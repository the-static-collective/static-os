{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/static-os/schema/measurement-path-audit-v0.json",
  "title":"Measurement path audit v0",
  "type":"object",
  "required":["schema","audit_id","candidate_source_sha256","criteria","claim_limit"],
  "properties":{
    "schema":{"const":"static.measurement-path-audit/v0"},
    "audit_id":{"type":"string","minLength":1},
    "candidate_source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "criteria":{
      "type":"object",
      "required":["channel_origin","capture_control","result_selection","operator_relation"],
      "properties":{
        "channel_origin":{
          "type":"object",
          "required":["status","evidence_sha256"],
          "properties":{
            "status":{"enum":["preexisting_or_external","derived_from_orientation","unknown"]},
            "evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          },
          "additionalProperties":false
        },
        "capture_control":{
          "type":"object",
          "required":["status","evidence_sha256"],
          "properties":{
            "status":{"enum":["not_controlled_by_orientation","controlled_by_orientation","unknown"]},
            "evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          },
          "additionalProperties":false
        },
        "result_selection":{
          "type":"object",
          "required":["status","evidence_sha256"],
          "properties":{
            "status":{"enum":["result_blind_capture","outcome_selected","unknown"]},
            "evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          },
          "additionalProperties":false
        },
        "operator_relation":{
          "type":"object",
          "required":["status","evidence_sha256"],
          "properties":{
            "status":{"enum":["independent_or_automatic","orientation_participant","unknown"]},
            "evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          },
          "additionalProperties":false
        }
      },
      "additionalProperties":false
    },
    "claim_limit":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
