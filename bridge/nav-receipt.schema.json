{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/static-os/schema/nav-receipt-v0.json",
  "title": "NAV receipt v0",
  "type": "object",
  "required": [
    "schema",
    "packet_id",
    "status",
    "heading",
    "preserve",
    "aperture",
    "bounded_move",
    "stop_condition",
    "observed",
    "delta",
    "next_heading"
  ],
  "properties": {
    "schema": {"const": "static.nav-receipt/v0"},
    "packet_id": {"const": "nav-001"},
    "status": {"enum": ["oriented", "contacted"]},
    "heading": {"type": "string", "minLength": 1},
    "preserve": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "aperture": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "bounded_move": {"type": "string", "minLength": 1},
    "stop_condition": {"type": "string", "minLength": 1},
    "claim_limit": {"type": "string"},
    "observed": {"type": ["string", "null"]},
    "delta": {"type": ["string", "null"]},
    "next_heading": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "contacted"}}},
      "then": {
        "properties": {
          "observed": {"type": "string", "minLength": 1},
          "delta": {"type": "string", "minLength": 1},
          "next_heading": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "additionalProperties": false
}
