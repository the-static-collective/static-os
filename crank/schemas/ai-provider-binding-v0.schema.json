{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "static-os.ai-provider-binding/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "provider_id", "model_id", "transport",
    "command", "timeout_seconds", "operator_configured"
  ],
  "properties": {
    "schema": {"const": "static-os.ai-provider-binding/v0"},
    "provider_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "transport": {"const": "stdio-json"},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
    "operator_configured": {"const": true}
  }
}
