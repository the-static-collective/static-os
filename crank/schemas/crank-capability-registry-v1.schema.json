{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "static-os.crank-capability-registry/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "node_id", "capabilities"],
  "properties": {
    "schema": {"const": "static-os.crank-capability-registry/v1"},
    "node_id": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "handler", "cost_units", "proposal_only", "authority"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "handler": {"enum": ["hash-text", "uppercase-text", "proposal-echo", "external-provider"]},
          "cost_units": {"type": "integer", "minimum": 0},
          "proposal_only": {"type": "boolean"},
          "authority": {"const": "none"},
          "provider": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema", "provider_id", "model_id", "transport", "command", "timeout_seconds", "operator_configured"],
            "properties": {
              "schema": {"const": "static-os.ai-provider-binding/v0"},
              "provider_id": {"type": "string", "minLength": 1},
              "model_id": {"type": "string", "minLength": 1},
              "transport": {"const": "stdio-json"},
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
              "operator_configured": {"const": true}
            }
          }
        }
      }
    }
  }
}
