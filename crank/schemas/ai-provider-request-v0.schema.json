{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "static-os.ai-provider-request/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "turn_id", "prompt", "proposal_only",
    "authority_request", "admission_request"
  ],
  "properties": {
    "schema": {"const": "static-os.ai-provider-request/v0"},
    "turn_id": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "proposal_only": {"const": true},
    "authority_request": {"const": "none"},
    "admission_request": {"const": "none"}
  }
}
