[Unit]
Description=STATIC OS HOUSE local-only browser supervisor
After=default.target

[Service]
Type=simple
ExecStart=/opt/static-os/workbench-venv/bin/static-workbench
Environment=STATIC_WORKBENCH_CONFIG=%h/.config/static-workbench/config.toml
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
