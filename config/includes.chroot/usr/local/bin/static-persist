#!/usr/bin/env python3
"""PERSISTENT-ROOT-001: initialize, witness, reopen, and attach a STATIC_STATE root."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import stat
import sys
import tempfile
import uuid
from datetime import datetime, timezone
from pathlib import Path

ROOT_SCHEMA = "static-os.persistent-root-instance/v0"
BOOT_SCHEMA = "static-os.boot-occurrence/v0"
SHUTDOWN_SCHEMA = "static-os.shutdown-occurrence/v0"
LAYOUT_VERSION = 0
DEFAULT_ROOT = Path("/var/lib/static-os")
DEFAULT_SHARE = Path("/usr/share/static-os")
RUN_DIR = Path("/run/static-os")
DIRS = (
    "users",
    "organs/ghot",
    "organs/relatte",
    "organs/jubilee",
    "organs/corpus",
    "organs/tranchnode",
    "crossing-exports",
    "lineage/boots",
    "lineage/shutdowns",
)

def now() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")

def root_path() -> Path:
    return Path(os.environ.get("STATIC_OS_PERSIST_ROOT", str(DEFAULT_ROOT))).resolve()

def share_path() -> Path:
    return Path(os.environ.get("STATIC_OS_SHARE_ROOT", str(DEFAULT_SHARE))).resolve()

def run_dir() -> Path:
    return Path(os.environ.get("STATIC_OS_RUN_ROOT", str(RUN_DIR))).resolve()

def atomic_json(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
    tmp = Path(tmp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.chmod(tmp, 0o600)
        tmp.replace(path)
    finally:
        if tmp.exists():
            tmp.unlink()

def sha256_file(path: Path) -> str | None:
    if not path.is_file():
        return None
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

def is_mountpoint(path: Path) -> bool:
    if os.environ.get("STATIC_OS_PERSIST_TEST") == "1":
        return path.is_dir()
    return path.is_mount()

def require_root_mount(path: Path) -> None:
    if not path.is_dir():
        raise ValueError(f"persistent root missing: {path}")
    if not is_mountpoint(path):
        raise ValueError(f"persistent root is not a mounted filesystem: {path}")

def root_manifest(path: Path) -> Path:
    return path / "root.json"

def validate_root(value: object) -> dict:
    if not isinstance(value, dict) or value.get("schema") != ROOT_SCHEMA:
        raise ValueError("unknown persistent root schema")
    if value.get("layout_version") != LAYOUT_VERSION:
        raise ValueError("unknown persistent root layout version")
    rid = value.get("root_id")
    try:
        uuid.UUID(str(rid))
    except Exception as exc:
        raise ValueError("invalid persistent root id") from exc
    if value.get("filesystem_label") != "STATIC_STATE":
        raise ValueError("persistent root label witness mismatch")
    return value

def load_root(path: Path) -> dict:
    return validate_root(json.loads(root_manifest(path).read_text(encoding="utf-8")))

def init_root(path: Path) -> dict:
    require_root_mount(path)
    manifest = root_manifest(path)
    if manifest.exists():
        value = load_root(path)
    else:
        entries = [p.name for p in path.iterdir()]
        if entries:
            raise ValueError("uninitialized persistent root is not empty; refusing adoption")
        value = {
            "schema": ROOT_SCHEMA,
            "layout_version": LAYOUT_VERSION,
            "root_id": str(uuid.uuid4()),
            "filesystem_label": "STATIC_STATE",
            "created_at": now(),
        }
        atomic_json(manifest, value)
    for rel in DIRS:
        (path / rel).mkdir(parents=True, exist_ok=True)
    os.chmod(path / "users", 0o1777)
    return value

def boot_files(root: Path) -> list[Path]:
    return sorted((root / "lineage" / "boots").glob("*.json"))

def read_boot(path: Path) -> dict:
    value=json.loads(path.read_text(encoding="utf-8"))
    if value.get("schema") != BOOT_SCHEMA:
        raise ValueError(f"unexpected boot receipt schema: {path}")
    return value

def previous_boot(root: Path) -> dict | None:
    receipts = [read_boot(p) for p in boot_files(root)]
    if not receipts:
        return None
    receipts.sort(key=lambda r: (r.get("opened_at",""), r.get("boot_id","")))
    return receipts[-1]

def source_witnesses(share: Path) -> dict:
    names = ("genesis-001.json", "whole-body-001.json", "persistent-root-001.json")
    return {name: sha256_file(share / name) for name in names}

def open_boot(root: Path, share: Path, runtime: Path) -> dict:
    root_value = init_root(root)
    prior = previous_boot(root)
    prior_id = prior.get("boot_id") if prior else None
    prior_closed = bool(
        prior_id and (root / "lineage" / "shutdowns" / f"{prior_id}.json").is_file()
    )
    boot_id = str(uuid.uuid4())
    receipt = {
        "schema": BOOT_SCHEMA,
        "boot_id": boot_id,
        "root_id": root_value["root_id"],
        "opened_at": now(),
        "previous_boot_id": prior_id,
        "previous_boot_has_shutdown_receipt": prior_closed if prior_id else None,
        "source_witnesses": source_witnesses(share),
        "claims": {
            "same_persistent_root": prior is not None,
            "same_process": False,
            "constituted_present_recovered": False,
        },
    }
    atomic_json(root / "lineage" / "boots" / f"{boot_id}.json", receipt)
    runtime.mkdir(parents=True, exist_ok=True)
    (runtime / "boot-id").write_text(boot_id + "\n", encoding="utf-8")
    return receipt

def close_boot(root: Path, runtime: Path) -> dict:
    require_root_mount(root)
    root_value = load_root(root)
    boot_id_file = runtime / "boot-id"
    if not boot_id_file.is_file():
        raise ValueError("current boot id unavailable; refusing synthetic shutdown")
    boot_id = boot_id_file.read_text(encoding="utf-8").strip()
    try:
        uuid.UUID(boot_id)
    except Exception as exc:
        raise ValueError("invalid current boot id") from exc
    boot_receipt = root / "lineage" / "boots" / f"{boot_id}.json"
    if not boot_receipt.is_file():
        raise ValueError("current boot receipt missing")
    output = root / "lineage" / "shutdowns" / f"{boot_id}.json"
    if output.exists():
        return json.loads(output.read_text(encoding="utf-8"))
    receipt = {
        "schema": SHUTDOWN_SCHEMA,
        "boot_id": boot_id,
        "root_id": root_value["root_id"],
        "closed_at": now(),
        "kind": "orderly-shutdown-observed",
        "claims": {
            "all_processes_completed": False,
            "all_external_crossings_resolved": False,
        },
    }
    atomic_json(output, receipt)
    return receipt

def attach_user(root: Path, home: Path, uid: int) -> dict:
    require_root_mount(root)
    load_root(root)
    user_root = root / "users" / str(uid)
    state = user_root / "static-workbench"
    state.mkdir(parents=True, exist_ok=True)
    target = home / ".local" / "state" / "static-workbench"
    target.parent.mkdir(parents=True, exist_ok=True)

    if target.is_symlink():
        resolved = target.resolve(strict=False)
        if resolved != state.resolve():
            raise ValueError(f"existing Workbench state symlink points elsewhere: {target}")
        action = "already-attached"
    elif target.exists():
        raise ValueError(
            f"existing Workbench state exists at {target}; refusing automatic replacement"
        )
    else:
        target.symlink_to(state)
        action = "attached"

    return {
        "action": action,
        "uid": uid,
        "persistent_root": str(root),
        "workbench_state": str(state),
        "link": str(target),
    }

def status(root: Path) -> dict:
    mounted = is_mountpoint(root)
    result = {
        "schema": "static-os.persistent-root-status/v0",
        "path": str(root),
        "mounted": mounted,
        "initialized": False,
    }
    if not mounted:
        return result
    manifest = root_manifest(root)
    if not manifest.is_file():
        result["state"] = "mounted-uninitialized"
        return result
    value = load_root(root)
    prior = previous_boot(root)
    result.update({
        "initialized": True,
        "root_id": value["root_id"],
        "layout_version": value["layout_version"],
        "last_boot_id": prior.get("boot_id") if prior else None,
        "last_boot_has_shutdown_receipt": (
            (root / "lineage" / "shutdowns" / f"{prior['boot_id']}.json").is_file()
            if prior else None
        ),
        "supabardo_interior_persisted": (root / "organs" / "supabardo").exists(),
        "crossing_exports_path": str(root / "crossing-exports"),
    })
    return result

def main(argv=None) -> int:
    parser=argparse.ArgumentParser(description=__doc__)
    sub=parser.add_subparsers(dest="command", required=True)
    sub.add_parser("init")
    sub.add_parser("boot")
    sub.add_parser("shutdown")
    sub.add_parser("status")
    attach=sub.add_parser("attach-user")
    attach.add_argument("--home", type=Path, default=Path.home())
    attach.add_argument("--uid", type=int, default=os.getuid())
    args=parser.parse_args(argv)

    root=root_path()
    try:
        if args.command == "init":
            print(json.dumps(init_root(root), indent=2))
        elif args.command == "boot":
            print(json.dumps(open_boot(root, share_path(), run_dir()), indent=2))
        elif args.command == "shutdown":
            print(json.dumps(close_boot(root, run_dir()), indent=2))
        elif args.command == "attach-user":
            print(json.dumps(attach_user(root, args.home.resolve(), args.uid), indent=2))
        else:
            print(json.dumps(status(root), indent=2))
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(f"REFUSE: {exc}", file=sys.stderr)
        return 2
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
