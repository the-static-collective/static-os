#!/bin/sh
# Runs in the interactive user's XFCE session, not as root.
set -eu
URL=http://127.0.0.1:13700/
systemctl --user start static-workbench.service || {
  echo "HOUSE user service unavailable; try: systemctl --user status static-workbench.service" >&2
  exit 1
}
attempt=0
while [ "$attempt" -lt 40 ]; do
  if curl --silent --show-error --fail --max-time 1 "$URL" >/dev/null 2>&1; then
    exec firefox-esr --new-window "$URL"
  fi
  attempt=$((attempt + 1))
  sleep 1
done
echo "HOUSE was not ready. Inspect: journalctl --user -u static-workbench.service" >&2
exit 1
