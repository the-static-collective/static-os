#!/bin/sh
# At user desktop login: open GENESIS, not HOUSE; user must click before work.
set -eu
URL=http://127.0.0.1:8766/
systemctl --user start static-genesis.service || {
  echo 'GENESIS user service unavailable. Inspect: journalctl --user -u static-genesis.service' >&2
  exit 1
}
count=0
while [ "$count" -lt 45 ]; do
  if curl -fsS --max-time 1 "$URL" >/dev/null 2>&1; then
    exec firefox-esr --new-window "$URL"
  fi
  count=$((count+1))
  sleep 1
done
echo 'GENESIS did not start; local recovery: systemctl --user status static-genesis.service' >&2
exit 1
